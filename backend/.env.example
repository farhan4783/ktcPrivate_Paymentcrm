# Express Backend Environment Variables

# The port where backend server will run
PORT=5000

# MongoDB Connection String (Atlas URI or Local URI)
# Example: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb://localhost:27017/paymentcrm

# Secret key used for signing JWT Authentication Tokens
JWT_SECRET=generate_a_random_jwt_secret_key_here

# Frontend URL (required for CORS and password reset redirection)
# Local React: http://localhost:5173
# Production React: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Email SMTP configuration (for forgot password/reset tokens)
# Common: gmail
EMAIL_SERVICE=gmail
# Your full Gmail address (e.g. example@gmail.com)
EMAIL_USER=your_email@gmail.com
# Google Account App Password (NOT your regular password! See steps.md)
EMAIL_PASS=your_app_password
